# Щохвилини. Вибір не з любові до частоти: p95 за добу з 288 замірів (раз на
# п'ять хвилин) — це чотирнадцятий найгірший, надто крупне зерно, щоб
# порівнювати вузли. Хвилина дає 1440 і, заразом, помічає падіння за дві
# хвилини замість десяти. Ціна — три запити /health на хвилину.
[Unit]
Description=Praxis: перевірка вітрини щохвилини

[Timer]
OnCalendar=minutely
AccuracySec=5s
Persistent=false

[Install]
WantedBy=timers.target
