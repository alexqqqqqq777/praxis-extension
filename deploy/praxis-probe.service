# Синтетична перевірка вітрини зі шлюза. Ставиться поруч із nginx, бо саме
# звідси видно те саме, що й юристові.
#
# Три цілі: публічна адреса через nginx, основний вузол adv по tailnet,
# запасний Studio по tailnet. Різниця між ними робить сповіщення осмисленим:
# «лежить adv, працюємо на Studio» замість «щось не так».
#
# Пише лише власні звернення: час, код, мілісекунди. Запитів юриста тут немає
# і бути не може — див. PRIVACY.md.
#
#   sudo install -m 755 tools/probe.py /usr/local/lib/praxis-probe.py
#   sudo cp deploy/praxis-probe.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now praxis-probe.timer
#
# Канал сповіщень — рішення власника. Поки його немає, зміни стану лишаються
# в /var/lib/praxis/probe.db і в journal. Коли з'явиться:
#   sudo systemctl edit praxis-probe.service
#   [Service]
#   Environment=PRAXIS_NOTIFY=/usr/local/bin/tg-send
[Unit]
Description=Praxis: синтетична перевірка вітрини
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/praxis-probe.py --once
Environment=PRAXIS_PROBE_DB=/var/lib/praxis/probe.db

# Нічого, крім мережі й власного каталогу, службі не потрібно.
DynamicUser=yes
StateDirectory=praxis
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=64M
TimeoutStartSec=60
