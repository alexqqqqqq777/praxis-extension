# УВАГА: бойовий токен у цьому файлі не зберігається. Один раз він сюди
# потрапив і опинився в публічному репозиторії — ключ довелося ротувати.
# Значення береться з /etc/systemd/system/praxis-cards.service на машині.
# Ключ НЕ зберігається в репозиторії.

[Unit]
Description=Praxis cards API (тестова вітрина практики ВС)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/praxis
Environment=CORPUS_DB=/home/ubuntu/praxis/praxis.db
Environment=LAW_DB=/home/ubuntu/praxis/praxis.db
Environment=PRAXIS_TOKEN=…спільний ключ вітрини, тут його немає…
Environment=PRAXIS_WORKERS=2
ExecStart=/usr/bin/python3 /home/ubuntu/praxis/cards_api.py --serve --host 127.0.0.1 --port 8788
Restart=on-failure
RestartSec=5
# щоб тестовий сервіс не з'їв пам'ять у сусідів
MemoryMax=512M
CPUQuota=80%
Nice=10

[Install]
WantedBy=multi-user.target
[Service]
# Машина має два ядра, і одне з них постійно тримає motion (відеоспостереження).
# Тому ми не намагаємося відвоювати CPU, а робимо менше роботи: лічильники по
# всіх 793 актах пораховані заздалегідь, картки збираються пакетними запитами.

# CPU. Вагу тримаємо низькою — саме вона вирішує суперечку за ядро, і motion
# виграє завжди. Квота ж — лише стеля: коли сусіди простоюють, ми беремо
# вільне, а коли ні — вага нас і так притискає.
# Квота — стеля на випадок сплеску, а не бажаний режим роботи.
CPUWeight=20
CPUQuota=80%
Nice=10

# Памʼять. Робочий пік — близько 120 МБ; MemoryHigh змушує ядро віддавати
# сторінки, не вбиваючи процес, MemoryMax лишається аварійним запобіжником.
MemoryHigh=320M
MemoryMax=448M
MemorySwapMax=0

# Диск. Читання з бази на 6,7 ГБ не має заважати сусідам.
IOWeight=20

# По потоку на зʼєднання: без стелі сплеск запитів породив би сотні потоків,
# кожен зі своїм зʼєднанням до SQLite.
TasksMax=48
