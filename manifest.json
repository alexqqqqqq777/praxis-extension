{
  "manifest_version": 3,
  "name": "Praxis — практика ВС поруч із законом",
  "version": "0.1.0",
  "description": "Правові висновки Верховного Суду з ЄДРСР поруч зі статтею закону на zakon.rada.gov.ua.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://zakon.rada.gov.ua/*",
    "https://praxis.51-83-129-254.sslip.io/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Praxis — практика ВС",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://zakon.rada.gov.ua/laws/show/*"
      ],
      "js": [
        "src/data.js",
        "src/api.js",
        "src/content.js"
      ],
      "css": [
        "src/page.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/rail.css"
      ],
      "matches": [
        "https://zakon.rada.gov.ua/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://praxis.51-83-129-254.sslip.io http://127.0.0.1:* http://localhost:*; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'"
  }
}
